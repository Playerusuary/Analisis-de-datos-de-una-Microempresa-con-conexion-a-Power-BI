{
  "name": "lonja-del-vecino",
  "version": "1.0.0",
  "description": "Sistema de logística — La Lonja del Vecino",
  "main": "contenedor/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.lalonjadelvecino.sistema",
    "productName": "La Lonja del Vecino",
    "win": {
      "target": "nsis",
      "icon": "frontend/assets/logo_negocio.png"
    },
    "directories": {
      "buildResources": ".",
      "output": "contenedor/dist"
    },
    "files": [
      "frontend/**",
      "base/**",
      "conexiones/**",
      "contenedor/main.js",
      "backend/logistica.exe",
      "backend/ventas.exe",
      "backend/restock.exe",
      "!backend/*.py",
      "!backend/__pycache__/**",
      "!backend/dist/**",
      "!backend/build/**",
      "!backend/*.spec"
    ]
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
